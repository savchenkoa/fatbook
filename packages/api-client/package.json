{
  "name": "@fatbook/api-client",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./go": "./src/go/index.ts"
  },
  "dependencies": {
    "@fatbook/shared": "*",
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  },
  "scripts": {
    "typegen:go": "openapi-typescript ../../apps/api/openapi.json -o src/go/schema.d.ts",
    "typecheck": "tsc --noEmit"
  }
}
