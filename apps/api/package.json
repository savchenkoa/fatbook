{
    "name": "@fatbook/api",
    "private": true,
    "version": "0.0.0",
    "scripts": {
        "dev": "go run ./cmd/api",
        "build": "sh scripts/build.sh",
        "lint": "sh scripts/lint.sh",
        "typecheck": "go build ./...",
        "test": "go test -race -count=1 ./...",
        "test:integration": "API_TEST_DATABASE_URL=postgres://fatbook_migrator:local-migrator@127.0.0.1:55432/fatbook_api?sslmode=disable go test -race -count=1 ./...",
        "db:up": "docker compose up -d --wait db",
        "db:stop": "docker compose stop db",
        "migrate": "go run ./cmd/migrate up",
        "migrate:status": "go run ./cmd/migrate status"
    }
}
